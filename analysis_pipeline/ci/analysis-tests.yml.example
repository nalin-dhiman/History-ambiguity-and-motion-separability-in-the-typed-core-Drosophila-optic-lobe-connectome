name: Analysis tests
on:
  push:
  pull_request:
permissions:
  contents: read
jobs:
  tests:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-python@v5
        with:
          python-version: '3.12'
          cache: pip
          cache-dependency-path: |
            requirements.txt
            analysis_pipeline/requirements-lock.txt
      - name: Install dependencies
        run: python -m pip install -r requirements.txt -r analysis_pipeline/requirements-lock.txt
      - name: Test without external datasets
        run: python analysis_pipeline/run.py --stage test
      - name: Check workflow commands
        run: python analysis_pipeline/run.py --stage all --dry-run
